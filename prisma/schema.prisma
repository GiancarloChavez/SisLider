generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String   @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash")
  rol          String   @default("admin") @db.VarChar(20)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  docente              Docente?
  asistencias          Asistencia[]
  asistenciasDocente   AsistenciaDocente[]
  abonos               Abono[]
  snackCompras         SnackCompra[]
  snackVentas          SnackVenta[]
  snackCajaDiaria      SnackCajaDiaria[]

  @@map("usuarios")
}

model Tutor {
  id               String  @id @default(uuid())
  nombre           String  @db.VarChar(100)
  apellido         String  @db.VarChar(100)
  celular          String  @db.VarChar(20)
  celularAdicional String? @map("celular_adicional") @db.VarChar(20)
  relacion         String  @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")

  tutorAlumnos TutorAlumno[]

  @@map("tutores")
}

model Alumno {
  id              String    @id @default(uuid())
  nombre          String    @db.VarChar(100)
  apellido        String    @db.VarChar(100)
  dni             String?   @unique @db.VarChar(8)
  celular         String?   @db.VarChar(20)
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  habilitado      Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")

  tutorAlumnos TutorAlumno[]
  matriculas   Matricula[]

  @@map("alumnos")
}

model TutorAlumno {
  id          String  @id @default(uuid())
  idTutor     String  @map("id_tutor")
  idAlumno    String  @map("id_alumno")
  esPrincipal Boolean @default(true) @map("es_principal")

  tutor  Tutor  @relation(fields: [idTutor], references: [id])
  alumno Alumno @relation(fields: [idAlumno], references: [id])

  @@unique([idTutor, idAlumno])
  @@map("tutor_alumno")
}

model Docente {
  id        String   @id @default(uuid())
  nombre    String   @db.VarChar(100)
  apellido  String   @db.VarChar(100)
  celular   String?  @db.VarChar(20)
  dni       String?  @unique @db.VarChar(8)
  idUsuario String?  @unique @map("id_usuario")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  usuario  Usuario?  @relation(fields: [idUsuario], references: [id])
  horarios Horario[]

  @@map("docentes")
}

model Aula {
  id        String  @id @default(uuid())
  nombre    String  @db.VarChar(50)
  capacidad Int     @default(20)
  activa    Boolean @default(true)

  horarios Horario[]

  @@map("aulas")
}

model Curso {
  id            String   @id @default(uuid())
  nombre        String   @db.VarChar(100)
  precioMensual Decimal? @map("precio_mensual") @db.Decimal(10, 2)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  horarios Horario[]

  @@map("cursos")
}

model Horario {
  id            String   @id @default(uuid())
  idCurso       String   @map("id_curso")
  idDocente     String   @map("id_docente")
  idAula        String   @map("id_aula")
  numeroGrupo   String    @map("numero_grupo") @db.VarChar(50)
  precioMensual Decimal   @map("precio_mensual") @db.Decimal(10, 2)
  cantidadMeses Int?      @map("cantidad_meses")
  fechaInicio   DateTime? @map("fecha_inicio") @db.Date
  fechaFin      DateTime? @map("fecha_fin") @db.Date
  horaInicio    DateTime  @map("hora_inicio") @db.Time
  horaFin       DateTime  @map("hora_fin") @db.Time
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")

  curso          Curso            @relation(fields: [idCurso], references: [id])
  docente        Docente          @relation(fields: [idDocente], references: [id])
  aula           Aula             @relation(fields: [idAula], references: [id])
  dias               HorarioDia[]
  periodos           HorarioPeriodo[]
  matriculas         Matricula[]
  recuperaciones     Recuperacion[]
  asistenciasDocente AsistenciaDocente[]

  @@unique([idCurso, numeroGrupo])
  @@map("horarios")
}

model HorarioPeriodo {
  id            String   @id @default(uuid())
  idHorario     String   @map("id_horario")
  numeroPeriodo Int      @map("numero_periodo")
  fechaInicio   DateTime @map("fecha_inicio") @db.Date
  fechaFin      DateTime @map("fecha_fin") @db.Date

  horario  Horario   @relation(fields: [idHorario], references: [id], onDelete: Cascade)
  mesPagos MesPago[]

  @@unique([idHorario, numeroPeriodo])
  @@map("horario_periodos")
}

model HorarioDia {
  id        String @id @default(uuid())
  idHorario String @map("id_horario")
  dia       String @db.VarChar(10)

  horario Horario @relation(fields: [idHorario], references: [id])

  @@map("horario_dias")
}

model GrupoDescuento {
  id          String  @id @default(uuid())
  nombre      String  @db.VarChar(100)
  descripcion String?
  activo      Boolean @default(true)

  descuentos Descuento[]

  @@map("grupo_descuentos")
}

model Descuento {
  id         String  @id @default(uuid())
  idGrupo    String? @map("id_grupo")
  nombre     String  @db.VarChar(100)
  tipo       String  @db.VarChar(20)
  valor      Decimal @db.Decimal(10, 2)
  automatico Boolean @default(true)
  activo     Boolean @default(true)

  grupo      GrupoDescuento? @relation(fields: [idGrupo], references: [id])
  matriculas Matricula[]

  @@map("descuentos")
}

model Matricula {
  id                 String    @id @default(uuid())
  idAlumno           String    @map("id_alumno")
  idHorario          String    @map("id_horario")
  idDescuento        String?   @map("id_descuento")
  precioFinalMensual Decimal   @map("precio_final_mensual") @db.Decimal(10, 2)
  fechaInicio        DateTime  @default(now()) @map("fecha_inicio") @db.Date
  fechaFin           DateTime? @map("fecha_fin") @db.Date
  estado             String    @default("activa") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at")

  alumno      Alumno       @relation(fields: [idAlumno], references: [id])
  horario     Horario      @relation(fields: [idHorario], references: [id])
  descuento   Descuento?   @relation(fields: [idDescuento], references: [id])
  dias        MatriculaDia[]
  mesesPago   MesPago[]
  asistencias Asistencia[]

  @@unique([idAlumno, idHorario])
  @@map("matriculas")
}

model MatriculaDia {
  id          String @id @default(uuid())
  idMatricula String @map("id_matricula")
  dia         String @db.VarChar(10)

  matricula Matricula @relation(fields: [idMatricula], references: [id])

  @@map("matricula_dias")
}

model MesPago {
  id               String    @id @default(uuid())
  idMatricula      String    @map("id_matricula")
  idPeriodo        String?   @map("id_periodo")
  anio             Int
  mes              Int
  montoTotal       Decimal   @map("monto_total") @db.Decimal(10, 2)
  montoPagado      Decimal   @default(0) @map("monto_pagado") @db.Decimal(10, 2)
  estado           String    @default("pendiente") @db.VarChar(20)
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  matricula Matricula       @relation(fields: [idMatricula], references: [id])
  periodo   HorarioPeriodo? @relation(fields: [idPeriodo], references: [id])
  abonos    Abono[]

  @@unique([idMatricula, anio, mes])
  @@map("meses_pago")
}

model Abono {
  id          String   @id @default(uuid())
  idMesPago   String   @map("id_mes_pago")
  idUsuario   String   @map("id_usuario")
  monto       Decimal  @db.Decimal(10, 2)
  metodoPago  String   @default("efectivo") @map("metodo_pago") @db.VarChar(20)
  fechaPago   DateTime @default(now()) @map("fecha_pago")
  observacion String?
  createdAt   DateTime @default(now()) @map("created_at")

  mesPago MesPago @relation(fields: [idMesPago], references: [id])
  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@map("abonos")
}

model Asistencia {
  id          String   @id @default(uuid())
  idMatricula String   @map("id_matricula")
  idUsuario   String   @map("id_usuario")
  fecha       DateTime @db.Date
  estado      String   @default("presente") @db.VarChar(20)
  observacion String?
  createdAt   DateTime @default(now()) @map("created_at")

  matricula    Matricula     @relation(fields: [idMatricula], references: [id])
  usuario      Usuario       @relation(fields: [idUsuario], references: [id])
  recuperacion Recuperacion?

  @@unique([idMatricula, fecha])
  @@map("asistencias")
}

model AsistenciaDocente {
  id        String   @id @default(uuid())
  idHorario String   @map("id_horario")
  idUsuario String   @map("id_usuario")
  fecha     DateTime @db.Date
  estado    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  horario Horario @relation(fields: [idHorario], references: [id])
  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@unique([idHorario, fecha])
  @@map("asistencias_docente")
}

model Recuperacion {
  id                   String    @id @default(uuid())
  idAsistencia         String    @unique @map("id_asistencia")
  idHorarioRecuperacion String?  @map("id_horario_recuperacion")
  fechaRecuperacion    DateTime? @map("fecha_recuperacion") @db.Date
  estado               String    @default("pendiente") @db.VarChar(20)
  observacion          String?
  createdAt            DateTime  @default(now()) @map("created_at")

  asistencia Asistencia @relation(fields: [idAsistencia], references: [id])
  horario    Horario?   @relation(fields: [idHorarioRecuperacion], references: [id])

  @@map("recuperaciones")
}

// ─── Snacks ───────────────────────────────────────────────────────────────────

model SnackProveedor {
  id        String   @id @default(uuid())
  nombre    String   @db.VarChar(100)
  ruc       String?  @unique @db.VarChar(11)
  contacto  String?  @db.VarChar(100)
  telefono  String?  @db.VarChar(20)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  compras SnackCompra[]

  @@map("snack_proveedores")
}

model SnackProducto {
  id               String    @id @default(uuid())
  nombre           String    @db.VarChar(100)
  categoria        String?   @db.VarChar(50)
  precioVenta      Decimal   @map("precio_venta") @db.Decimal(10, 2)
  costoReferencial Decimal?  @map("costo_referencial") @db.Decimal(10, 2)
  stockActual      Int       @default(0) @map("stock_actual")
  stockMinimo      Int       @default(0) @map("stock_minimo")
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")

  itemsCompra SnackCompraItem[]
  itemsVenta  SnackVentaItem[]

  @@map("snack_productos")
}

model SnackCompra {
  id          String   @id @default(uuid())
  idProveedor String   @map("id_proveedor")
  idUsuario   String   @map("id_usuario")
  fecha       DateTime @default(now()) @db.Date
  total       Decimal  @db.Decimal(10, 2)
  observacion String?
  createdAt   DateTime @default(now()) @map("created_at")

  proveedor SnackProveedor    @relation(fields: [idProveedor], references: [id])
  usuario   Usuario           @relation(fields: [idUsuario], references: [id])
  items     SnackCompraItem[]

  @@map("snack_compras")
}

model SnackCompraItem {
  id         String  @id @default(uuid())
  idCompra   String  @map("id_compra")
  idProducto String  @map("id_producto")
  cantidad   Int
  precioUnit Decimal @map("precio_unit") @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  compra   SnackCompra   @relation(fields: [idCompra], references: [id], onDelete: Cascade)
  producto SnackProducto @relation(fields: [idProducto], references: [id])

  @@map("snack_compra_items")
}

model SnackVenta {
  id        String   @id @default(uuid())
  idUsuario String   @map("id_usuario")
  fecha     DateTime @default(now()) @db.Date
  total     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario          @relation(fields: [idUsuario], references: [id])
  items   SnackVentaItem[]

  @@map("snack_ventas")
}

model SnackVentaItem {
  id         String  @id @default(uuid())
  idVenta    String  @map("id_venta")
  idProducto String  @map("id_producto")
  cantidad   Int
  precioUnit Decimal @map("precio_unit") @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  venta    SnackVenta    @relation(fields: [idVenta], references: [id], onDelete: Cascade)
  producto SnackProducto @relation(fields: [idProducto], references: [id])

  @@map("snack_venta_items")
}

model SnackCajaDiaria {
  id            String   @id @default(uuid())
  idUsuario     String   @map("id_usuario")
  fecha         DateTime @unique @db.Date
  montoApertura Decimal  @map("monto_apertura") @db.Decimal(10, 2)
  montoCierre   Decimal? @map("monto_cierre") @db.Decimal(10, 2)
  estado        String   @default("abierta") @db.VarChar(20)
  observacion   String?
  createdAt     DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [idUsuario], references: [id])

  @@map("snack_caja_diaria")
}
